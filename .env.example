# Paystack secret key (server only). Use sk_test_ while developing.
PAYSTACK_SECRET_KEY=

# Optional public key. Checkout uses the access code from the server.
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_

# Optional. If unset, the app creates a R200 / month ZAR plan named
# "NewRecall Salon Monthly" on first checkout.
# PAYSTACK_PLAN_CODE=PLN_

# Local only: skip the paywall while working on the CRM.
# VITE_PAYWALL_BYPASS=true

# Closed-app notification push (Web Push + Upstash Redis).
# Generate VAPID keys: npx web-push generate-vapid-keys
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: protect the hourly cron on Vercel
# CRON_SECRET=
